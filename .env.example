# Server Port
PORT=3000

# Optional: Fixed Sender Address (e.g. noreply@gmail.com or authorized user)
SENDER_EMAIL=noreply@gmail.com

# -------------------------------------------------------------
# Option A: Gmail App Password (easiest for testing)
# 1. Enable 2-Step Verification in Google Account.
# 2. Generate an App Password under Security -> App Passwords.
# -------------------------------------------------------------
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -------------------------------------------------------------
# Option B: Gmail OAuth2 Authentication
# -------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token
# GMAIL_USER=your-email@gmail.com

# -------------------------------------------------------------
# Option C: Custom SMTP (SendGrid, Mailtrap, SES, etc.)
# -------------------------------------------------------------
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Note: If no credentials are configured above, the server automatically
# initializes an Ethereal test account so you can send and preview test emails
# instantly on localhost without setup!
